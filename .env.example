# =============================================================================
# Viola — environment
#
# The whole app runs with ZERO of these set. Defaults resolve to mock providers
# backed by committed fixtures, so `pnpm dev` and CI produce a complete,
# realistic look with no accounts and no spend. Add keys as you get them and
# flip the matching provider to `live`.
# =============================================================================

# --- Provider selection ------------------------------------------------------
# Master switch: `mock` (default) | `live`
VIOLA_PROVIDERS=mock
# Per-provider overrides. Each falls back to VIOLA_PROVIDERS when unset, so you
# can go live one integration at a time.
# VIOLA_VISION_PROVIDER=live
# VIOLA_PRODUCT_PROVIDER=live
# VIOLA_AFFILIATE_PROVIDER=live
# VIOLA_STORAGE_PROVIDER=live

# --- Database ----------------------------------------------------------------
# Unset => in-process PGlite (real Postgres 18, no Docker). Great for dev/CI.
# Set to a Supabase/Postgres connection string for anything shared.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viola

# --- Supabase (auth + storage) ----------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=viola

# --- Vision: garment identification -----------------------------------------
# Google AI Studio key. Only thing that can read "HOKA SKYWARD X BLUE" off a photo.
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-flash-latest

# --- Product search: "where to buy" -----------------------------------------
# SerpApi google_shopping. 250 free searches/mo.
# SERPAPI_API_KEY=
# Alternative provider, cheaper at volume:
# SEARCHAPI_API_KEY=

# --- Affiliate ---------------------------------------------------------------
# Sovrn //Commerce: one account, 50k+ merchants, server-side link wrapping.
# Leave unset to use the Noop provider — links go direct, clicks still tracked,
# so the product is complete before any affiliate account exists.
# SOVRN_API_KEY=

# --- Payments ----------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
# NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=
# iOS uses StoreKit via RevenueCat — Apple requires IAP for in-app digital features.
# REVENUECAT_SECRET_KEY=
# REVENUECAT_WEBHOOK_SECRET=

# --- Analytics & monitoring --------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SENTRY_DSN=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs guest identity cookies so a share recipient can Bloom without an account.
# Generate: openssl rand -base64 32
# VIOLA_GUEST_SECRET=

# --- Cost guardrails ---------------------------------------------------------
# Free-tier AI look-tags per user per week.
VIOLA_FREE_WEEKLY_LOOKS=5
# Hard stop on paid API spend per day, in USD cents. Pipeline degrades gracefully.
VIOLA_DAILY_SPEND_CAP_CENTS=2000

# Manual tagging mode. Set to 1 to skip paid product lookup entirely: garments
# are still detected, scored and laid out, and the poster adds the shop links
# themselves. Drops a look from roughly $0.027 to $0.0016.
#
# Worth understanding before switching it off again — the product cache is
# GLOBAL, so every link a user contributes removes that item from the paid path
# for everyone. Running in manual mode early builds a catalogue that makes the
# automated path permanently cheaper.
# VIOLA_MANUAL_TAGGING=1
