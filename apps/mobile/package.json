{
  "name": "@viola/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .expo dist ios .turbo"
  },
  "dependencies": {
    "@viola/core": "workspace:*",
    "@viola/design": "workspace:*",
    "expo": "~57.0.13",
    "expo-apple-authentication": "~57.0.1",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "^57.0.11",
    "expo-constants": "~57.0.0",
    "expo-font": "^57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "^57.0.6",
    "expo-status-bar": "~57.0.0",
    "expo-superwall": "^1.3.0",
    "expo-system-ui": "^57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-purchases": "^10.7.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
