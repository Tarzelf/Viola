    "clean": "rm -rf .next dist .turbo",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@viola/core": "workspace:*",
