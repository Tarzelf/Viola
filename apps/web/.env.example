# Viola web — copy to .env.local and fill what you need.
# Mock providers work with nothing set.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Soft launch: gate the product behind /early (share links stay public)
# VIOLA_INVITE_ONLY=1

# Live providers (see docs/PROVIDERS.md)
# VIOLA_PROVIDERS=live
# GEMINI_API_KEY=
# SERPAPI_API_KEY=
# SOVRN_API_KEY=

# Database (omit for local PGlite)
# DATABASE_URL=

# Auth / guests
# VIOLA_GUEST_SECRET=

# Whop (web Plus) — see docs/BILLING.md
WHOP_ACCOUNT_ID=biz_C5RaxuzjBv7KDk
WHOP_PRODUCT_ID=prod_Dbdsn3dazecNe
WHOP_PLAN_MONTHLY=plan_N10txmmhZciIL
WHOP_PLAN_ANNUAL=plan_xtUcJ3EzAQ3MY
# WHOP_API_KEY=
# WHOP_WEBHOOK_SECRET=

# Superwall (iOS Plus)
# EXPO_PUBLIC_SUPERWALL_API_KEY=

# Cron for affiliate reconciliation
# VIOLA_CRON_SECRET=

# Analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Moderators (comma-separated emails)
# VIOLA_MODERATOR_EMAILS=

# Manual tagging mode — skip paid product search
# VIOLA_MANUAL_TAGGING=1

# Apple Universal Links team id (for apple-app-site-association)
# APPLE_TEAM_ID=

# CORS for Expo web
# VIOLA_CORS_ORIGINS=https://your-expo-web.example
